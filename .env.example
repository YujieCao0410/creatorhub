# Copy this file to `.env` and fill in real values.

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (see docker-compose.yml), also switch `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://creatorhub:creatorhub@localhost:5432/creatorhub?schema=public"

# --- Auth ---
# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin (used for Stripe redirect URLs). Defaults to localhost:3000.
APP_URL="http://localhost:3000"

# --- Stripe (optional; billing is disabled until all three are set) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` or the webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the recurring "Pro" product
STRIPE_PRICE_PRO="price_..."
