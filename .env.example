# Copy this file to `.env` and fill in real values.

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (see docker-compose.yml), also switch `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://creatorhub:creatorhub@localhost:5432/creatorhub?schema=public"

# --- Auth ---
# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin (used for Stripe redirect URLs). Defaults to localhost:3000.
APP_URL="http://localhost:3000"

# --- Stripe (optional; billing is disabled until all three are set) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` or the webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the recurring "Pro" product (default currency, e.g. CAD $29.9/mo)
STRIPE_PRICE_PRO="price_..."
# Optional: a CNY price (¥29.9/mo) used when the UI locale is Chinese.
# Falls back to STRIPE_PRICE_PRO when unset.
STRIPE_PRICE_PRO_CNY="price_..."

# --- YouTube publishing (optional) ---
# Google Cloud OAuth 2.0 Web client with the YouTube Data API v3 enabled.
# Authorized redirect URI: <APP_URL>/api/integrations/youtube/callback
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- AI captions & hashtags (optional) ---
# Anthropic API key from https://console.anthropic.com/settings/keys
# Without it, the "AI captions & tags" button is hidden.
ANTHROPIC_API_KEY="sk-ant-..."
# Model for caption generation. Default: claude-opus-5.
# Set to claude-haiku-4-5 for a much cheaper option.
# ANTHROPIC_MODEL="claude-opus-5"
