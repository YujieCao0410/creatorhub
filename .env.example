# Copy this file to `.env` and fill in real values.

# --- Database (PostgreSQL) ---
# Local dev: `docker compose up -d` starts one on :5432.
DATABASE_URL="postgresql://creatorhub:creatorhub@localhost:5432/creatorhub?schema=public"
# Production: a managed Postgres connection string (Neon, Vercel Postgres, …).

# --- Auth ---
# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin (used for Stripe redirect URLs). Defaults to localhost:3000.
APP_URL="http://localhost:3000"

# --- Stripe (optional; billing is disabled until all three are set) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` or the webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the recurring "Pro" product (default currency, e.g. CAD $29.9/mo)
STRIPE_PRICE_PRO="price_..."
# Optional: a CNY price (¥29.9/mo) used when the UI locale is Chinese.
# Falls back to STRIPE_PRICE_PRO when unset.
STRIPE_PRICE_PRO_CNY="price_..."

# --- YouTube publishing (optional) ---
# Google Cloud OAuth 2.0 Web client with the YouTube Data API v3 enabled.
# Authorized redirect URI: <APP_URL>/api/integrations/youtube/callback
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- TikTok publishing (optional) ---
# App from developers.tiktok.com with the "Content Posting API" product and
# scopes user.info.basic + video.publish. Redirect URI:
# <APP_URL>/api/integrations/tiktok/callback
# Unaudited apps: sandbox only, test users only, posts forced to private.
TIKTOK_CLIENT_KEY="..."
TIKTOK_CLIENT_SECRET="..."

# --- Instagram publishing (optional) ---
# Meta app (developers.facebook.com) with "Instagram API with Instagram Login".
# Needs an Instagram Business/Creator account. Redirect URI:
# <APP_URL>/api/integrations/instagram/callback
# Instagram fetches the video from a PUBLIC https URL, so this only works once
# CreatorHub is deployed at a real domain — not on localhost.
INSTAGRAM_APP_ID="..."
INSTAGRAM_APP_SECRET="..."

# --- Douyin publishing (optional) ---
# App from open.douyin.com with the video.create scope approved. Redirect URI:
# <APP_URL>/api/integrations/douyin/callback
# No sandbox: an unaudited app only works for accounts added as testers, and
# posts land for real on that account.
DOUYIN_CLIENT_KEY="..."
DOUYIN_CLIENT_SECRET="..."

# --- Threads publishing (optional) ---
# Same Meta app as Instagram (developers.facebook.com) — add the "Access
# Threads API" use case. Redirect URI: <APP_URL>/api/integrations/threads/callback
THREADS_APP_ID="..."
THREADS_APP_SECRET="..."

# --- Media storage ---
# Set on a serverless deploy (the filesystem is ephemeral). From the Vercel
# dashboard → Storage → Blob. Unset locally → uploads go to public/uploads/.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- AI captions & hashtags (optional) ---
# Anthropic API key from https://console.anthropic.com/settings/keys
# Without it, the "AI captions & tags" button is hidden.
ANTHROPIC_API_KEY="sk-ant-..."
# Model for caption generation. Default: claude-opus-5.
# Set to claude-haiku-4-5 for a much cheaper option.
# ANTHROPIC_MODEL="claude-opus-5"
