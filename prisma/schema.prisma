// CreatorHub data model.
// Provider is SQLite for zero-setup local development. The schema avoids
// SQLite-only features so it can move to PostgreSQL by changing `provider`
// and the DATABASE_URL (see docker-compose.yml and README).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // "native" for local dev; the linux targets cover Docker (Debian) and most
  // serverless platforms (RHEL/Amazon Linux).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A registered account. Every user also has a public creator profile
/// (handle, name, bio, avatar), so there is no separate Profile table.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  handle       String   @unique
  name         String
  passwordHash String
  bio          String?
  avatarUrl    String?
  /// Space-separated default hashtags pre-filled into every new post
  /// (lowercase, no "#"). Empty string = none.
  defaultTags  String   @default("")
  /// "FREE" | "PRO" — the effective plan. Kept denormalized on the user so
  /// authorization checks are a single read; Stripe webhooks keep it in sync
  /// with the Subscription row.
  membership   String   @default("FREE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  following    Follow[]       @relation("follower")
  followers    Follow[]       @relation("following")
  subscription Subscription?
  integrations Integration[]
}

/// An OAuth connection to an external platform (currently just "youtube").
/// One row per (user, provider).
model Integration {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String
  /// Human-readable account label from the provider (e.g. YouTube channel name).
  accountName        String?
  accessToken        String
  refreshToken       String?
  /// When the access token expires (epoch ms). Refreshed on demand.
  expiresAt          DateTime?
  scope              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, provider])
}

/// Billing state mirrored from Stripe. One row per user (created lazily on first
/// checkout). `status` holds the Stripe subscription status verbatim.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  status               String    @default("incomplete")
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// A piece of content written by a user. Drafts have `published = false`;
/// publishing stamps `publishedAt` and flips the flag.
model Post {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String
  coverImageUrl String?
  /// Path to an uploaded video (served from /uploads). Null for text posts.
  videoUrl      String?
  /// Space-separated, normalized tags (lowercase, no "#"). Empty string = none.
  tags          String    @default("")
  /// Per-language platform captions as a JSON map `{ "<lang>": "<text>" }`
  /// (e.g. `{ "en": "...", "zh": "...", "ja": "..." }`). Falls back to
  /// title + content for a language that has no caption.
  captions      Json      @default("{}")
  /// Set once the video has been pushed to YouTube.
  youtubeUrl    String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes          Like[]
  comments       Comment[]
  publishTargets PublishTarget[]

  @@index([authorId])
  @@index([published, publishedAt])
}

/// One row per (post, platform) distribution attempt. Tracks where a video has
/// been sent and the outcome. `status`: pending | publishing | published |
/// failed | manual (needs the creator to upload by hand).
model PublishTarget {
  id          String    @id @default(cuid())
  platform    String
  lang        String    @default("en")
  status      String    @default("pending")
  externalUrl String?
  error       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
}

/// One row per (user, post) like. The composite unique constraint makes
/// "like" idempotent and lets us count likes cheaply.
model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

/// A comment on a post.
model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// A directed "follower -> following" edge between two users.
model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId  String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}
